{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store products with pricing, category tags, images, videos, and stock levels",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the product",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Primary category",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Full product description",
          "maxLength": 5000
        },
        "price": {
          "type": "number",
          "description": "Product selling price"
        },
        "originalPrice": {
          "type": "number",
          "description": "Original product price for discount comparison"
        },
        "isPromoActive": {
          "type": "boolean",
          "description": "Flag indicating if promo tag is active"
        },
        "stock": {
          "type": "number",
          "description": "Quantity in inventory"
        },
        "showStock": {
          "type": "boolean",
          "description": "Whether to display stock number to customers"
        },
        "colorStockControl": {
          "type": "boolean",
          "description": "Whether inventory is split per color variant"
        },
        "isBestSeller": {
          "type": "boolean",
          "description": "Flag for best seller highlight"
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Flag for featured product highlight"
        }
      },
      "required": ["name", "category", "price", "stock"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Marketing and promotional carousel billboard banners",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Banner headline title",
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "description": "Banner secondary tagline",
          "maxLength": 500
        },
        "tag": {
          "type": "string",
          "description": "Top promotional tag chip",
          "maxLength": 100
        },
        "image": {
          "type": "string",
          "description": "Image data URI or URL",
          "maxLength": 5000000
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        }
      },
      "required": ["title", "image"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sale order record including customer, delivery/pickup, items, payment and stock deduction",
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string",
          "description": "Name of the customer",
          "maxLength": 200
        },
        "clientPhone": {
          "type": "string",
          "description": "WhatsApp or phone of customer",
          "maxLength": 50
        },
        "deliveryType": {
          "type": "string",
          "description": "Type of dispatch: entrega (delivery) or retirada (pickup)",
          "enum": ["entrega", "retirada"]
        },
        "pickupLocation": {
          "type": "string",
          "description": "Meeting point or pickup location agreed with customer",
          "maxLength": 300
        },
        "deliveryDate": {
          "type": "string",
          "description": "Delivery or meeting date (YYYY-MM-DD)",
          "maxLength": 20
        },
        "subtotal": {
          "type": "number",
          "description": "Subtotal amount of products"
        },
        "deliveryFee": {
          "type": "number",
          "description": "Delivery fee charged"
        },
        "discount": {
          "type": "number",
          "description": "Discount applied"
        },
        "total": {
          "type": "number",
          "description": "Final total value of sale"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method (pix, dinheiro, cartao_credito, etc.)",
          "maxLength": 50
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment status: pago, na_entrega, a_prazo",
          "enum": ["pago", "na_entrega", "a_prazo"]
        },
        "dueDate": {
          "type": "string",
          "description": "Due date if payment is a_prazo (YYYY-MM-DD)",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "description": "Sale status: concluida or cancelada",
          "enum": ["concluida", "cancelada"]
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        }
      },
      "required": ["clientName", "deliveryType", "total", "paymentMethod", "paymentStatus"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public catalog products collection, editable only by Thyago (admin)"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Promotional billboard banners, editable only by Thyago (admin)"
    },
    "/promo_banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Promotional category banners, editable only by Thyago (admin)"
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Orders and sales PDV collection, accessible only by Thyago (admin)"
    }
  }
}
