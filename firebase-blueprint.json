{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store products with pricing, category tags, images, videos, and stock levels",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the product",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Primary category",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Full product description",
          "maxLength": 5000
        },
        "price": {
          "type": "number",
          "description": "Product selling price"
        },
        "originalPrice": {
          "type": "number",
          "description": "Original product price for discount comparison"
        },
        "isPromoActive": {
          "type": "boolean",
          "description": "Flag indicating if promo tag is active"
        },
        "stock": {
          "type": "number",
          "description": "Quantity in inventory"
        },
        "showStock": {
          "type": "boolean",
          "description": "Whether to display stock number to customers"
        },
        "colorStockControl": {
          "type": "boolean",
          "description": "Whether inventory is split per color variant"
        },
        "isBestSeller": {
          "type": "boolean",
          "description": "Flag for best seller highlight"
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Flag for featured product highlight"
        }
      },
      "required": ["name", "category", "price", "stock"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Marketing and promotional carousel billboard banners",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Banner headline title",
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "description": "Banner secondary tagline",
          "maxLength": 500
        },
        "tag": {
          "type": "string",
          "description": "Top promotional tag chip",
          "maxLength": 100
        },
        "image": {
          "type": "string",
          "description": "Image data URI or URL",
          "maxLength": 5000000
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        }
      },
      "required": ["title", "image"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public catalog products collection, editable only by Thyago (admin)"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Promotional billboard banners, editable only by Thyago (admin)"
    }
  }
}
