rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'thyago.tech3@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products catalog: Anyone can browse; only Admin (Thyago) can write/edit/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId);
    }

    // Banners collection: Anyone can view; only Admin (Thyago) can manage
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(bannerId);
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
